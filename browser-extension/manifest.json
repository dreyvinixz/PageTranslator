{
  "manifest_version": 3,
  "name": "PageTranslator Finder — Preview",
  "version": "0.6.0",
  "description": "Segmentação geométrica de instâncias, OCR local português/inglês, idioma e tradução local quando suportada.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PageTranslator Finder: abrir e configurar"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/logo.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
