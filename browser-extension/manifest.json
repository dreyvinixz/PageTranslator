{
  "manifest_version": 3,
  "name": "PageTranslator Finder — Preview",
  "version": "0.7.1",
  "description": "OCR confiável com timeout por etapa e Finder com separação geométrica de painéis, máscaras e idiomas.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PageTranslator Finder: abrir e configurar"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/logo.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
