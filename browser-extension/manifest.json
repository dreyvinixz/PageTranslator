{
  "manifest_version": 3,
  "name": "PageTranslator Finder — Preview",
  "version": "0.5.0",
  "description": "Finder de HQ: varredura automática, associação conservadora balão–texto e atalho personalizável; sem OCR ou tradução.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PageTranslator Finder: abrir e configurar"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/logo.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
