{
  "manifest_version": 3,
  "name": "PageTranslator — HQs EN → PT",
  "version": "0.2.2",
  "description": "Reconheça balões de HQ com OCR mais estável e econômico no Chrome ou Edge.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "offscreen"],
  "host_permissions": ["https://api.mymemory.translated.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PageTranslator: iniciar/pausar tradução automática"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
